---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import tagsData from '../../public/Media/tags13.json';

const numDivisions = tagsData.length;
let numServices = 0;
let numActions = 0;

tagsData.forEach((cat: any) => {
	if (cat.subcategories) {
		numServices += cat.subcategories.length;
		cat.subcategories.forEach((sub: any) => {
			if (sub.tags) {
				numActions += sub.tags.length;
			}
		});
	}
});
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={import.meta.env.BASE_URL + 'Media/favicon.png'} />
		<meta name="viewport" content="width=1440" />
		<meta name="generator" content={Astro.generator} />
		<title>Сервисы и услуги — Baisanat Holding</title>
		<meta name="description" content="Экосистема проектных возможностей Baisanat Holding" />
